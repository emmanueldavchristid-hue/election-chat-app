# ========================================
# LLM PROVIDER CONFIGURATION
# ========================================
# Choisir le provider LLM : 'ollama', 'anthropic', ou 'openai'
LLM_PROVIDER=ollama

# ========================================
# OLLAMA CONFIGURATION (Local, Gratuit)
# ========================================
# Installation : https://ollama.ai
# Télécharger un modèle : ollama pull llama3.1:8b
# Modèles recommandés :
#   - llama3.1:8b      → Rapide, bon compromis (4.9GB)
#   - qwen2.5-coder:14b → Meilleure précision SQL (9.0GB)
#   - sqlcoder:7b       → Spécialisé SQL uniquement (4.4GB)
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# ========================================
# PDF SOURCE CONFIGURATION
# ========================================
PDF_URL=https://www.cei.ci/wp-content/uploads/2025/12/EDAN_2025_RESULTAT_NATIONAL_DETAILS.pdf


# ========================================
# ANTHROPIC CONFIGURATION (Cloud, Payant)
# ========================================
# Obtenir une clé API : https://console.anthropic.com
# Coût : ~$0.003-0.015 par requête (très rapide, 2-3 secondes)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ========================================
# OPENAI CONFIGURATION (Cloud, Payant)
# ========================================
# Option 1 : OpenAI direct (https://platform.openai.com)
# Option 2 : OpenRouter (https://openrouter.ai - accès à plusieurs modèles)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=openai/gpt-4o-mini
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# ========================================
# DATABASE CONFIGURATION
# ========================================
# Chemin vers la base DuckDB (créée par l'ingestion)
DB_PATH=data/processed/elections.duckdb

# Limites de sécurité
MAX_QUERY_RESULTS=1000
QUERY_TIMEOUT_SECONDS=30

# ========================================
# APP CONFIGURATION
# ========================================
LOG_LEVEL=INFO
APP_TITLE=Election Results Chat - Côte d'Ivoire 2025
APP_PORT=8501

# ========================================
# NOTES D'INSTALLATION
# ========================================
# 1. Copier ce fichier : cp .env.example .env
# 2. Éditer .env avec vos vraies clés API
# 3. Choisir votre provider (ollama recommandé pour commencer)
# 4. Si ollama : ollama pull llama3.1:8b
# 5. Lancer : streamlit run src/app/streamlit_app.py

# ========================================
# COMPARAISON PROVIDERS
# ========================================
# OLLAMA (Local)
#   ✅ Gratuit, privé, offline
#   ⚠️ Nécessite GPU/CPU puissant
#   ⏱️ 10-60 secondes par requête
#
# ANTHROPIC (Cloud)
#   ✅ Ultra rapide (2-3s)
#   ✅ Très haute précision
#   ⚠️ Payant (~$0.005/requête)
#   ⚠️ Nécessite connexion internet
#
# OPENAI (Cloud)
#   ✅ Rapide (3-5s)
#   ✅ Modèles variés
#   ⚠️ Payant (variable selon modèle)
